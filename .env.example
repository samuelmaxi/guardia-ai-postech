# Provedor da LLM: openai | google_genai | anthropic | xai | groq
# Sem LLM_PROVIDER/LLM_MODEL/chave, a app roda em modo degradado (ML + SHAP + fontes, sem texto da LLM).
LLM_PROVIDER=openai
# Modelos sugeridos:
#   openai       -> gpt-4o-mini
#   google_genai -> gemini-2.0-flash
#   anthropic    -> claude-haiku-5-5
#   xai          -> grok-3-mini
#   groq         -> llama-3.3-70b-versatile
LLM_MODEL=gpt-4o-mini

# Preencha só a chave do provedor escolhido
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=

# Opcional: caminho do log de auditoria
# AUDIT_LOG=logs/auditoria.jsonl
